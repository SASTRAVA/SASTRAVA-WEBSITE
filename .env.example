# Optional public GA4 measurement ID (Vercel variable name: VITE_GA_MEASUREMENT_ID).
# Analytics remains disabled until configured and explicitly accepted by the visitor.
# Successful lead-form submissions emit GA4's `generate_lead` event after consent.
VITE_GA_MEASUREMENT_ID=

# Server-only contact storage and notification settings. Keep values out of source control.
POSTGRES_URL=
POSTGRES_CA_CERT=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
SITE_ORIGIN=https://sastrava.com
